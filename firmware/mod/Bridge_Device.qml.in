import airAssignments 1.0
import InputAssignment 0.1
import OutputAssignment 0.1
import Device 0.1

import QtQuick 2.0

// MX5 Bridge @VERSION@ (unofficial)
// Request: F0 7D 48 52 <seq> <cmd> <ASCII payload> F7
// Reply: F0 7D 48 52 <seq> <cmd|0x40> <part> <total> <ASCII payload> F7
// Long header (0.6+): if the client sets bit 0x20 in <cmd>, the reply uses
// ... <cmd|0x40> <part hi> <part lo> <total hi> <total lo> ... (7 bits each, up to 16383 parts
// = about 6 MB instead of 127 parts/about 48 KB). Without the bit, use the pre-0.6 format
// so older clients work unchanged.
//   0x01 PING                              -> "<version> <filename>"
//   0x02 GET      "<path>"                 -> "<path>\t<json>"
//   0x03 SET      "<path>\t<field>\t<value>" -> "<path>\t<json>"
//                 Fields: value, unnormalized, state, index, string, user (= display selection)
//   0x04 ENTRIES  "<path>"                 -> "<path>\t<json-list>"
//   0x05 GETMANY  "<path>\n<path>..."      -> "<json-object path:info>"
//   0x07 EVAL     "<js-function-body>"     -> "<result>" (developer command)
//   0x08 SQL      "<sql>"                  -> "{ok, rows, err}" read-only, via mx5bridge-db.sh
//                 (asynchronous reply when the database service responds; 0.6+ uses
//                 sqlite3 -safe: no file writes or shell)
//   0x09 SQLWRITE "<sql-statements>"       -> "{ok, rows, err}" writes in one transaction;
//                 rows = [{changes}]; the service backs up the database before the first write
//   0x0A ACTION   "status|backup|restore|restart|diag" -> "{ok, rows, err}" (restore/restart
//                 stop the app; the startup loop relaunches it; bridge unavailable for ~15 s)
//   0x0B SHELL    "<shell-script>"         -> "{ok, rows: [{rc, out}], err}" as root,
//                 60 s timeout (0.6+; previously used .system in the SQL read channel)
//   Errors                                -> 0x7F "<text>"
//   (0x06 RIG existed through 0.4; App.apiRigs is inaccessible in this context)
// Characters (0.5+): SysEx carries 7 bits. Every character except TAB, LF and
// 0x20..0x7E travels in either direction as 0x7F plus four uppercase hex digits per UTF-16 unit,
// e.g. U+00FC -> 7F "00FC"; non-BMP characters use two units
// (a surrogate pair). 0x7F never appears in ordinary text, so escaping is unambiguous.
// Through 0.4, each such character became '?'.
Device {
	id: device

	property string bridgeVersion: "MX5Bridge-@VERSION@"
	property string deviceFileName: "@NAME@"
	property string sqlDir: "/tmp/mx5bridge"
	property int sqlTimeoutMs: 90000
	property int chunkSize: 380
	property int rxCount: 0
	property int errCount: 0
	property int sqlCount: 0
	property var sqlPending: ({})   // id -> { seq, base, cmd, long, deadline }

	// Database service: write a request file, wait for <base>.rdy, then read the
	// reply from filenames in <base>.r via App.entryList. Through 0.5 a JS file
	// was imported; each import grew app memory by ~2.5 KB.
	// Use a property, not a child object: Device does not create children (undefined id).
	property Timer sqlTimer: Timer {
		interval: 25
		repeat: true
		running: false
		onTriggered: device.pollSql()
	}

	// kind: 'q' read (0x08), 'w' write (0x09), 'a' action (0x0A), 's' shell (0x0B).
	// The service infers kind from the filename; replyCmd is the reply command (cmd|0x40).
	function sqlRequest(seq, sql, kind, replyCmd, longHdr)
	{
		sqlCount++;
		var id = sqlCount;
		var base = sqlDir + "/" + kind + id;
		App.writeToFile(sql, base + ".sql");
		App.writeToFile("go\n", base + ".go");
		sqlPending[id] = { seq: seq, base: base, cmd: replyCmd, long: longHdr,
		                   deadline: Date.now() + sqlTimeoutMs };
		sqlTimer.running = true;
	}

	// Service reply: sort '<number>_<chunk>' filenames and join their base64url chunks.
	// Qt.atob returns Unicode text already decoded from UTF-8.
	function readReply(base)
	{
		var dir = base + ".r";
		var pre = dir + "/";
		var list = App.entryList("file://" + dir, ["*"], false);
		var parts = [];
		for (var i = 0; i < list.length; i++) {
			var e = String(list[i]);
			if (e.indexOf(pre) === 0 && e.length > pre.length)
				parts.push(e.substr(pre.length));
		}
		parts.sort();
		var s = "";
		for (var k = 0; k < parts.length; k++)
			s += parts[k].substr(parts[k].indexOf("_") + 1);
		var text = Qt.atob(s.replace(/-/g, "+").replace(/_/g, "/"));
		JSON.parse(text);   // Validate: e.g. two SQL result sets do not form valid JSON.
		return text;
	}

	function pollSql()
	{
		var open = false;
		for (var id in sqlPending) {
			var p = sqlPending[id];
			if (App.isFileExist(p.base + ".rdy")) {
				var text;
				try {
					text = readReply(p.base);
				} catch (e) {
					text = JSON.stringify({ ok: false, rows: [], err: "Unreadable reply: " + e });
				}
				App.writeToFile("done\n", p.base + ".done");
				delete sqlPending[id];
				try { reply(p.seq, p.cmd, text, p.long); } catch (e) { errCount++; reply(p.seq, 0x7F, "" + e, p.long); }
			} else if (Date.now() > p.deadline) {
				delete sqlPending[id];
				reply(p.seq, 0x7F, "SQL: no reply from database service (mx5bridge-db.sh)", p.long);
			} else {
				open = true;
			}
		}
		sqlTimer.running = open;
	}

	// Journal only (through 0.5 also wrote a status file on the USB drive)
	function logStatus(msg)
	{
		console.warn("MX5Bridge[" + deviceFileName + "]: " + msg);
	}

	Component.onCompleted: { logStatus(bridgeVersion + " geladen"); }

	function hex2(n)
	{
		var s = (n & 0x7F).toString(16).toUpperCase();
		return s.length < 2 ? "0" + s : s;
	}

	// Text -> 7-bit text: escape characters outside TAB/LF/0x20..0x7E as 0x7F + four hex digits
	function escapeText(text)
	{
		return text.replace(/[^\t\n\x20-\x7E]/g, function (ch) {
			var h = ch.charCodeAt(0).toString(16).toUpperCase();
			return String.fromCharCode(0x7F) + "0000".substr(h.length) + h;
		});
	}

	function unescapeText(text)
	{
		return text.replace(/\x7F([0-9A-Fa-f]{4})/g, function (m, h) {
			return String.fromCharCode(parseInt(h, 16));
		});
	}

	function textToHex(text)
	{
		var out = [];
		for (var i = 0; i < text.length; i++)
			out.push(hex2(text.charCodeAt(i)));
		return out.join(" ");
	}

	// longHdr: part index and total each use 14 bits (two bytes) instead of 7 bits
	function reply(seq, cmd, text, longHdr)
	{
		text = escapeText(String(text));
		var total = Math.max(1, Math.ceil(text.length / chunkSize));
		if (total > (longHdr ? 16383 : 127))
			throw "Reply too large (" + text.length + " characters)";
		for (var part = 0; part < total; part++) {
			var chunk = text.substr(part * chunkSize, chunkSize);
			var msg = "F0 7D 48 52 " + hex2(seq) + " " + hex2(cmd) + " ";
			if (longHdr)
				msg += hex2(part >> 7) + " " + hex2(part) + " " + hex2(total >> 7) + " " + hex2(total);
			else
				msg += hex2(part) + " " + hex2(total);
			if (chunk.length > 0)
				msg += " " + textToHex(chunk);
			Midi.sendSysEx(msg + " F7");
		}
	}

	function translatorOf(path)
	{
		var p = App.getProperty(path);
		if (!p || !p.translator)
			throw "No property: " + path;
		return p.translator;
	}

	function infoOf(path)
	{
		var t;
		try { t = translatorOf(path); } catch (e) { return { ok: false, err: "" + e }; }
		var r = { ok: true };
		var fields = ["value", "unnormalized", "state", "index", "string",
		              "numEntries", "maximum", "defaultValue", "valueType", "editable"];
		for (var i = 0; i < fields.length; i++) {
			try {
				var v = t[fields[i]];
				var ty = typeof v;
				if (ty === "number" || ty === "boolean" || ty === "string")
					r[fields[i]] = v;
			} catch (e) { }
		}
		return r;
	}

	function writeProp(path, field, text)
	{
		var t = translatorOf(path);
		if (field === "state")
			t.state = (text === "1" || text === "true");
		else if (field === "index")
			t.index = parseInt(text, 10);
		else if (field === "user")
			t.setCurrentIdxByUser(parseInt(text, 10));
		else if (field === "value")
			t.value = parseFloat(text);
		else if (field === "unnormalized")
			t.unnormalized = parseFloat(text);
		else if (field === "string")
			t.string = text;
		else
			throw "Unknown field: " + field;
	}

	function entriesOf(path)
	{
		var t = translatorOf(path);
		var n = t.numEntries;
		var list = t.entries;
		if (!list)
			throw "No entry list: " + path;
		var out = [];
		for (var i = 0; i < n; i++)
			out.push(list[i] === undefined ? null : String(list[i]));
		return out;
	}

	function toText(v)
	{
		if (v === undefined)
			return "undefined";
		if (v === null || typeof v !== "object")
			return String(v);
		try { return JSON.stringify(v); } catch (e) { return String(v); }
	}

	function sysEx(sysExString)
	{
		var parts = String(sysExString).replace(/^\s+|\s+$/g, "").split(/\s+/);
		if (parts.length < 6)
			return;
		var b = [];
		for (var i = 0; i < parts.length; i++)
			b.push(parseInt(parts[i], 16));

		// Accept only our own messages: F0 7D 48 52 ...
		if (b[0] !== 0xF0 || b[1] !== 0x7D || b[2] !== 0x48 || b[3] !== 0x52)
			return;

		rxCount++;
		var seq = b[4];
		var longHdr = (b[5] & 0x20) !== 0;   // Reply with 14-bit part counters (0.6+)
		var cmd = b[5] & 0x1F;
		var end = b[b.length - 1] === 0xF7 ? b.length - 1 : b.length;
		var payload = "";
		for (var j = 6; j < end; j++)
			payload += String.fromCharCode(b[j] & 0x7F);
		payload = unescapeText(payload);

		try {
			if (cmd === 0x01) {
				reply(seq, 0x41, bridgeVersion + " " + deviceFileName, longHdr);
			} else if (cmd === 0x02) {
				reply(seq, 0x42, payload + "\t" + JSON.stringify(infoOf(payload)), longHdr);
			} else if (cmd === 0x03) {
				var f = payload.split("\t");
				if (f.length < 3)
					throw "SET expects path<TAB>field<TAB>value";
				writeProp(f[0], f[1], f.slice(2).join("\t"));
				reply(seq, 0x43, f[0] + "\t" + JSON.stringify(infoOf(f[0])), longHdr);
			} else if (cmd === 0x04) {
				reply(seq, 0x44, payload + "\t" + JSON.stringify(entriesOf(payload)), longHdr);
			} else if (cmd === 0x05) {
				var paths = payload.split("\n");
				var res = {};
				for (var k = 0; k < paths.length; k++)
					if (paths[k].length)
						res[paths[k]] = infoOf(paths[k]);
				reply(seq, 0x45, JSON.stringify(res), longHdr);
			} else if (cmd === 0x07) {
				var fn = new Function("App", "Midi", "device", payload);
				reply(seq, 0x47, toText(fn(App, Midi, device)), longHdr);
			} else if (cmd === 0x08) {
				if (!payload.length)
					throw "SQL expects a query";
				sqlRequest(seq, payload, "q", 0x48, longHdr);
			} else if (cmd === 0x09) {
				if (!payload.length)
					throw "SQLWRITE expects statements";
				sqlRequest(seq, payload, "w", 0x49, longHdr);
			} else if (cmd === 0x0A) {
				if (!payload.length)
					throw "ACTION expects a name";
				sqlRequest(seq, payload, "a", 0x4A, longHdr);
			} else if (cmd === 0x0B) {
				if (!payload.length)
					throw "SHELL expects a script";
				sqlRequest(seq, payload, "s", 0x4B, longHdr);
			} else {
				throw "Unknown command " + cmd;
			}
		} catch (e) {
			errCount++;
			reply(seq, 0x7F, "" + e, longHdr);
			if (errCount < 20)
				logStatus("Error: " + e);
		}
	}

	Component.onDestruction: { console.warn("MX5Bridge[" + deviceFileName + "]: entladen"); }
}
